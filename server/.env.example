# Gmail SMTP Configuration:
# 1. Turn on 2-Step Verification in Google Account (https://myaccount.google.com/security)
# 2. Generate a 16-character App Password (https://myaccount.google.com/apppasswords)
# 3. Enter your Gmail address and 16-character app password below:
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# Optional Custom SMTP settings (defaults to Gmail smtp.gmail.com:465)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# EMAIL_FROM="Eventora" <your_email@gmail.com>

PORT=5000
